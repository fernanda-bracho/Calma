<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/tituloCita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 Agendar Cita Psicológica"
        android:textColor="@color/primary_teal"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona tu horario prioritario bajo el convenio corporativo de bienestar."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Campo de Motivo o Especialidad -->
    <EditText
        android:id="@+id/etMotivoCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Motivo de consulta o área de apoyo"
        android:inputType="textLongMessage"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background_normal" />

    <!-- Botón de Confirmación -->
    <Button
        android:id="@+id/btnConfirmarCita"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="@color/primary_teal"
        android:text="CONFIRMAR CITA"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

</LinearLayout>