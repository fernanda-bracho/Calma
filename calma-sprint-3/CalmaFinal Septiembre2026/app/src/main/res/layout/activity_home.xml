<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".homeActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Es tu momento... Relajate con Calma+"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_musica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎶 Música Relajante"
        android:layout_marginBottom="12dp"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btn_respiracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧘 Ejercicio de Respiración"
        android:layout_marginBottom="12dp"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btn_contacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💬 Contacto Psicólogo"
        android:layout_marginBottom="12dp"
        android:padding="12dp"/>

    <!-- 🚨 Botón de Pánico / SOS (Calma+ Empresas) -->
    <Button
        android:id="@+id/btn_panico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 Módulo de Emergencia SOS"
        android:backgroundTint="@color/emergency_red"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp"
        android:padding="12dp"/>

    <!-- 📅 Agendar Cita con Beneficio Corporativo -->
    <Button
        android:id="@+id/btn_citas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 Agendar Cita Psicológica"
        android:backgroundTint="@color/primary_teal"
        android:textColor="@color/white"
        android:layout_marginBottom="20dp"
        android:padding="12dp"/>

    <!-- ☀️🌙 Controles de Brillo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnBajarBrillo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌙 Menos Brillo"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSubirBrillo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☀️ Más Brillo"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>